{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Reach",
  "version": "0.4.9",
  "identifier": "com.thefiredev.reach",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reach",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Tanner Osterkamp",
    "copyright": "Copyright (c) 2026 Alexander Nt. MIT License. Fork maintained by Tanner Osterkamp.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/thefiredev-cloud/Reach",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform SSH client and remote management tool",
    "longDescription": "Reach is a cross-platform SSH client with SFTP, port tunneling, an encrypted vault, serial console, Ansible and OpenTofu workspaces and Lua plugins. This build is Tanner Osterkamp fork of alexandrosnt/Reach.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"],
        "section": "net"
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator-gtk3"]
      }
    }
  }
}
